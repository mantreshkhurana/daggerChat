# daggerChat Configuration

# Arbitrum RPC endpoint (get from https://alchemy.com or https://infura.io)
RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_API_KEY

# For testnet (Arbitrum Sepolia)
# RPC_URL=https://arb-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# Your wallet private key (without 0x prefix)
# WARNING: Never commit your actual private key!
PRIVATE_KEY=your_private_key_here

# DaggerChat contract address (after deployment)
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Log level (trace, debug, info, warn, error)
LOG_LEVEL=info
